{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "compare_at_price": {
      "type": "number"
    },
    "sku": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "boxer",
        "pack"
      ],
      "default": "boxer"
    },
    "pack_size": {
      "type": "number"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "color_name": {
      "type": "string"
    },
    "color_hex": {
      "type": "string"
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "bestseller": {
      "type": "boolean",
      "default": false
    },
    "badge": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "review_count": {
      "type": "number",
      "default": 0
    },
    "stock": {
      "type": "number",
      "default": 0
    },
    "material": {
      "type": "string"
    },
    "fit": {
      "type": "string"
    },
    "care_instructions": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "slug",
    "price"
  ]
}