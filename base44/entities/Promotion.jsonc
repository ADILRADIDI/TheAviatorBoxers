{
  "name": "Promotion",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "slug": { "type": "string" },
    "active": { "type": "boolean", "default": true },
    "starts_at": { "type": "string" },
    "ends_at": { "type": "string" },
    "title_fr": { "type": "string" },
    "title_darija": { "type": "string" },
    "subtitle_fr": { "type": "string" },
    "subtitle_darija": { "type": "string" },
    "badge_fr": { "type": "string" },
    "badge_darija": { "type": "string" },
    "image_url": { "type": "string" },
    "background_color": { "type": "string", "default": "#0A192F" },
    "text_color": { "type": "string", "default": "#FFFFFF" },
    "accent_color": { "type": "string", "default": "#D5E500" },
    "coupon_code": { "type": "string" },
    "cta_label_fr": { "type": "string" },
    "cta_label_darija": { "type": "string" },
    "cta_url": { "type": "string" },
    "sort_order": { "type": "number", "default": 0 }
  },
  "required": ["name", "title_fr", "active"]
}
