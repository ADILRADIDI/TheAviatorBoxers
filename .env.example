# Local Docker services
POSTGRES_DB=aviator
POSTGRES_USER=aviator
POSTGRES_PASSWORD=generate-a-long-random-password
POSTGRES_PORT=5432
REDIS_PORT=6379
FRONTEND_PORT=8080

# Application connection strings
DATABASE_URL=postgresql://aviator:generate-a-long-random-password@localhost:5432/aviator
REDIS_URL=redis://localhost:6379

# Frontend/API values to define during the Next.js/NestJS migration
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001
VITE_API_URL=http://localhost:3001
ADMIN_EMAIL=admin@theaviator.local
ADMIN_PASSWORD=generate-a-password-with-at-least-12-characters
ADMIN_SECRET=generate-a-long-random-secret
MEDIA_ROOT=./storage/media
