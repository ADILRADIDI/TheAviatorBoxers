# ============================================================
# The Aviator — environment template
# Copy to .env.local (frontend) / .env (infra) and fill values.
# NEVER commit real secrets.
# ============================================================

# --- API / database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379
API_PORT=3001
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SECRET=change-me-32-char-random-secret
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3001
VITE_BASE44_APP_ID=your-base44-app-id

# --- Analytics / marketing (fill from client accounts) ---
VITE_GA_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=XXXXXXXXXXX
VITE_TIKTOK_PIXEL_ID=XXXXXXXXXXX

# --- WhatsApp / contact ---
VITE_WHATSAPP_NUMBER=2126XXXXXXXX